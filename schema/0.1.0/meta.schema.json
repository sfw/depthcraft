{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://depthcraft.dev/schema/0.1.0/meta.schema.json",
  "title": "DepthcraftLessonMeta",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lessonId", "anchors"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "lessonId": { "type": "string", "minLength": 1 },
    "anchors": {
      "type": "array",
      "description": "Section headings and tap-to-explain glosses for complex concepts.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "heading", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "heading": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["section", "concept", "warning", "prerequisite"] },
          "term": { "type": "string", "minLength": 1, "description": "Text to underline for tap-to-explain" },
          "gloss": { "type": "string", "minLength": 1, "description": "Explanation shown in sheet (markdown)" }
        }
      }
    }
  }
}
